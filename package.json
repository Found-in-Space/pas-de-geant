{
  "name": "@found-in-space/pas-de-geant-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Walk around worlds, one small step at a time",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Found-in-Space/pas-de-geant#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Found-in-Space/pas-de-geant"
  },
  "bugs": {
    "url": "https://github.com/Found-in-Space/pas-de-geant/issues"
  },
  "workspaces": [
    "apps/pas-de-geant",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @found-in-space/pas-de-geant && npm run build --workspace @found-in-space/pas-de-geant-app",
    "amazon:outlines": "node scripts/build-amazon-forest-outlines.mjs",
    "check": "npm run typecheck",
    "dev": "npm run dev --workspace @found-in-space/pas-de-geant-app --",
    "quest:debug": "node scripts/quest-debug.mjs",
    "lunar:tiles": "node scripts/build-lunar-tiles.mjs",
    "test": "npm run build --workspace @found-in-space/pas-de-geant && vitest run",
    "test:browser": "playwright test --config playwright.pas-de-geant.config.ts",
    "test:browser:xr": "playwright test --config playwright.pas-de-geant-xr.config.ts",
    "typecheck": "npm run build --workspace @found-in-space/pas-de-geant && tsc --build --pretty false && tsc --project tsconfig.tools.json --pretty false",
    "api:build": "node scripts/build-api-server.mjs",
    "api:serve": "node dist/api/server.mjs",
    "check:spatial-package": "npm run build --workspace @found-in-space/pas-de-geant && node scripts/check-spatial-dependencies.mjs",
    "build:embed": "npm run build --workspace @found-in-space/pas-de-geant && vite build --config vite.embed.config.ts",
    "check:package": "node scripts/check-geant-package.mjs",
    "examples": "npm run build --workspace @found-in-space/pas-de-geant && vite --config vite.examples.config.ts",
    "build:examples": "npm run build --workspace @found-in-space/pas-de-geant && vite build --config vite.examples.config.ts",
    "check:embed": "node scripts/check-geant-browser.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@found-in-space/skykit": "0.3.0-alpha.0",
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "esbuild": "0.28.1",
    "@found-in-space/spatial": "0.3.0-alpha.1",
    "three": "0.170.0"
  }
}
