{
  "name": "@found-in-space/pas-de-geant-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Walk around worlds, one small step at a time",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Found-in-Space/pas-de-geant#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Found-in-Space/pas-de-geant"
  },
  "bugs": {
    "url": "https://github.com/Found-in-Space/pas-de-geant/issues"
  },
  "workspaces": [
    "apps/pas-de-geant",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @found-in-space/worlds && npm run build --workspace @found-in-space/pas-de-geant",
    "amazon:outlines": "node scripts/build-amazon-forest-outlines.mjs",
    "check": "npm run typecheck",
    "dev": "npm run dev --workspace @found-in-space/pas-de-geant --",
    "quest:debug": "node scripts/quest-debug.mjs",
    "lunar:tiles": "node scripts/build-lunar-tiles.mjs",
    "test": "npm run build --workspace @found-in-space/worlds && vitest run",
    "test:browser": "playwright test --config playwright.pas-de-geant.config.ts",
    "test:browser:xr": "playwright test --config playwright.pas-de-geant-xr.config.ts",
    "typecheck": "npm run build --workspace @found-in-space/worlds && tsc --build --pretty false && tsc --project tsconfig.tools.json --pretty false"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
