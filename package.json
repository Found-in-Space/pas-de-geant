{
  "name": "@found-in-space/pas-de-geant-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Composable planetary worlds, navigation, and browser experiences",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Found-in-Space/pas-de-geant#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Found-in-Space/pas-de-geant"
  },
  "bugs": {
    "url": "https://github.com/Found-in-Space/pas-de-geant/issues"
  },
  "workspaces": [
    "integration",
    "packages/*"
  ],
  "scripts": {
    "prepare:development": "node scripts/prepare-development-dependencies.mjs",
    "build": "npm run build --workspace @found-in-space/pas-de-geant",
    "check": "npm run typecheck",
    "dev": "npm run dev:integration --",
    "dev:integration": "npm run build && npm run dev --workspace @found-in-space/geant-integration --",
    "build:integration": "npm run build && npm run build --workspace @found-in-space/geant-integration",
    "quest:debug": "node scripts/quest-debug.mjs",
    "test": "npm run build --workspace @found-in-space/pas-de-geant && vitest run",
    "typecheck": "npm run build && tsc --project tsconfig.tools.json --pretty false && npm run typecheck --workspace @found-in-space/geant-integration",
    "check:spatial-package": "npm run build --workspace @found-in-space/pas-de-geant && node scripts/check-spatial-dependencies.mjs",
    "build:embed": "npm run build --workspace @found-in-space/pas-de-geant && vite build --config vite.embed.config.ts",
    "check:package": "node scripts/check-geant-package.mjs",
    "examples": "npm run build --workspace @found-in-space/pas-de-geant && vite --config vite.examples.config.ts",
    "build:examples": "npm run build --workspace @found-in-space/pas-de-geant && vite build --config vite.examples.config.ts",
    "check:embed": "node scripts/check-geant-browser.mjs",
    "check:sky-isolation": "npm run build && node scripts/check-sky-isolation.mjs",
    "prepare:interaction": "node ../skykit/scripts/stage-interaction-development.mjs ../touch-os .",
    "test:interaction:package": "node ../skykit/scripts/check-interaction-packed-consumer.mjs .packages/touch-os.tgz ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@found-in-space/guided-journey": "file:.packages/guided-journey.tgz",
    "@found-in-space/hr-diagram": "file:.packages/hr-diagram.tgz",
    "@found-in-space/skykit": "file:.packages/skykit.tgz",
    "@found-in-space/spatial": "0.3.0-alpha.1",
    "@found-in-space/three-star-field": "file:.packages/three-star-field.tgz",
    "@found-in-space/touch-os": "file:.packages/touch-os.tgz",
    "@found-in-space/voice-os": "file:.packages/voice-os.tgz",
    "@playwright/test": "1.55.1",
    "@pmndrs/pointer-events": "6.6.32",
    "@types/node": "22.18.6",
    "esbuild": "0.28.1",
    "three": "0.170.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@found-in-space/guided-journey": "$@found-in-space/guided-journey",
    "@found-in-space/touch-os": "$@found-in-space/touch-os",
    "@found-in-space/skykit": "$@found-in-space/skykit",
    "@found-in-space/three-star-field": "$@found-in-space/three-star-field",
    "@found-in-space/hr-diagram": "$@found-in-space/hr-diagram",
    "@found-in-space/voice-os": "$@found-in-space/voice-os"
  }
}
