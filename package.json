{
  "name": "@found-in-space/pas-de-geant-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Walk around worlds, one small step at a time",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Found-in-Space/pas-de-geant#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Found-in-Space/pas-de-geant"
  },
  "bugs": {
    "url": "https://github.com/Found-in-Space/pas-de-geant/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @found-in-space/pas-de-geant",
    "build:all": "npm run build && npm run build:shadowline",
    "build:packages": "npm run build --workspace @found-in-space/shadowline && npm run build --workspace @found-in-space/shadowline-astronomy-engine",
    "build:shadowline": "npm run build:packages && npm run build --workspace @found-in-space/shadowline-visualizer",
    "check": "npm run typecheck",
    "changeset": "changeset",
    "dev": "npm run dev --workspace @found-in-space/pas-de-geant --",
    "dev:shadowline": "npm run dev --workspace @found-in-space/shadowline-visualizer --",
    "release:publish": "changeset publish",
    "release:check-packed-consumers": "node ./scripts/check-packed-consumers.mjs",
    "release:lockfile": "npm install --package-lock-only --ignore-scripts --no-audit --fund=false",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version && npm run release:lockfile",
    "test": "vitest run",
    "test:browser": "playwright test --config playwright.pas-de-geant.config.ts",
    "test:browser:all": "npm run test:browser && npm run test:browser:shadowline",
    "test:browser:shadowline": "playwright test --config playwright.config.ts",
    "typecheck": "tsc --build --pretty false && tsc --project tsconfig.tools.json --pretty false"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
