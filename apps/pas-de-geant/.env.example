# Server-only. Never rename this to a VITE_* variable.
OPENAI_API_KEY=

# Optional Nominatim-compatible reverse-geocoding endpoint.
PAS_DE_GEANT_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
# Optional Nominatim-compatible place-search endpoint.
PAS_DE_GEANT_FORWARD_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# Optional photographic imagery metadata exposed to the client. The upstream
# URL and its credentials are server-only below.
VITE_IMAGERY_ATTRIBUTION=
VITE_IMAGERY_PROVIDER_ID=
VITE_IMAGERY_TILE_SIZE=
VITE_IMAGERY_MIN_ZOOM=
VITE_IMAGERY_MAX_ZOOM=

# Optional Flight Follower WebSocket override.
VITE_FLIGHT_FOLLOWER_STREAM_URL=wss://flight-follower.dev.k-si.com/v1/stream

# Server-only cached tile-provider registry. Browser code receives only the
# corresponding /api/tiles routes.
PAS_DE_GEANT_TILE_PROXY_TEXTURES_UPSTREAM_TEMPLATE=
PAS_DE_GEANT_TILE_PROXY_TEXTURES_SCHEME=xyz
# Elevation is independently configurable and defaults to Mapterhorn.
PAS_DE_GEANT_TILE_PROXY_ELEVATION_UPSTREAM_TEMPLATE=https://tiles.mapterhorn.com/{z}/{x}/{y}.webp
PAS_DE_GEANT_TILE_PROXY_ELEVATION_SCHEME=xyz
# Optional full-sphere lunar geographic pyramids. Without these, the bundled
# 2K LROC colour map and a flat displacement surface remain available.
PAS_DE_GEANT_TILE_PROXY_LUNAR_IMAGERY_UPSTREAM_TEMPLATE=
PAS_DE_GEANT_TILE_PROXY_LUNAR_IMAGERY_SCHEME=xyz
PAS_DE_GEANT_TILE_PROXY_LUNAR_ELEVATION_UPSTREAM_TEMPLATE=
PAS_DE_GEANT_TILE_PROXY_LUNAR_ELEVATION_SCHEME=xyz
# Optional fixed upstream request headers and incoming headers to forward.
# Provider-specific values override the shared defaults below.
PAS_DE_GEANT_TILE_PROXY_UPSTREAM_HEADERS_JSON={}
PAS_DE_GEANT_TILE_PROXY_FORWARD_REQUEST_HEADERS=origin,referer,user-agent
PAS_DE_GEANT_TILE_PROXY_TEXTURES_UPSTREAM_HEADERS_JSON=
PAS_DE_GEANT_TILE_PROXY_TEXTURES_FORWARD_REQUEST_HEADERS=
PAS_DE_GEANT_TILE_PROXY_ELEVATION_UPSTREAM_HEADERS_JSON=
PAS_DE_GEANT_TILE_PROXY_ELEVATION_FORWARD_REQUEST_HEADERS=
PAS_DE_GEANT_TILE_PROXY_LUNAR_IMAGERY_UPSTREAM_HEADERS_JSON=
PAS_DE_GEANT_TILE_PROXY_LUNAR_IMAGERY_FORWARD_REQUEST_HEADERS=
PAS_DE_GEANT_TILE_PROXY_LUNAR_ELEVATION_UPSTREAM_HEADERS_JSON=
PAS_DE_GEANT_TILE_PROXY_LUNAR_ELEVATION_FORWARD_REQUEST_HEADERS=
# Optional additional or overriding provider records. Example:
# '{"contours":{"urlTemplate":"https://tiles.example/{z}/{x}/{y}.png","scheme":"tms","upstreamHeaders":{"X-Api-Key":"secret"},"forwardRequestHeaders":["user-agent"]}}'
PAS_DE_GEANT_TILE_PROXY_PROVIDERS_JSON=
# At most about 100 new upstream requests start per second, with 16 in flight.
PAS_DE_GEANT_TILE_PROXY_MAX_CONCURRENCY=16
PAS_DE_GEANT_TILE_PROXY_MIN_INTERVAL_MS=10
# Used only when an otherwise cacheable response has no explicit lifetime.
PAS_DE_GEANT_TILE_PROXY_DEFAULT_TTL_MS=86400000
# Queue-wide fallback for 429/503 responses without a longer Retry-After.
PAS_DE_GEANT_TILE_PROXY_UPSTREAM_BACKOFF_MS=5000
# Browser lifetime for synthetic texture tiles served during upstream backoff.
PAS_DE_GEANT_TILE_PROXY_TEXTURES_FALLBACK_TTL_MS=60000
# Optional override. The default is the platform user cache, shared by worktrees.
# Relative overrides resolve from apps/pas-de-geant; absolute paths are accepted.
# PAS_DE_GEANT_TILE_PROXY_CACHE_DIRECTORY=/absolute/path/to/tile-cache
# Comma-separated credential parameters omitted from each cache identity.
PAS_DE_GEANT_TILE_PROXY_CACHE_KEY_IGNORED_QUERY_PARAMETERS=key
