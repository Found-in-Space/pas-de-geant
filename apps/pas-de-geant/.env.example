# Application APIs and local lunar files stay on the development machine.
# Configure only the independent tile cache endpoint below.

# Server-only. Never rename this to a VITE_* variable.
OPENAI_API_KEY=

# Optional Nominatim-compatible reverse-geocoding endpoint.
PAS_DE_GEANT_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
# Optional Nominatim-compatible place-search endpoint.
PAS_DE_GEANT_FORWARD_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# Optional public imagery/elevation source URLs for production.
# Development MapTiler requests are rejected unless deliberately overridden.
VITE_IMAGERY_XYZ_TEMPLATE=
VITE_ELEVATION_XYZ_TEMPLATE=
# Independent cache endpoint when application APIs run locally.
PAS_DE_GEANT_TILE_CACHE_URL=https://tile-cache.int.k-si.com
# Emergency opt-in only: I_ACCEPT_MAPTILER_RATE_LIMIT_RISK
PAS_DE_GEANT_ALLOW_DIRECT_MAPTILER=
VITE_IMAGERY_ATTRIBUTION=
VITE_IMAGERY_PROVIDER_ID=
VITE_IMAGERY_TILE_SIZE=
VITE_IMAGERY_MIN_ZOOM=
VITE_IMAGERY_MAX_ZOOM=

# Optional Flight Follower WebSocket override.
VITE_FLIGHT_FOLLOWER_STREAM_URL=wss://flight-follower.dev.k-si.com/v1/stream

# Optional admitted lunar pyramids. New format 2 products declare their grid;
# immutable format 1 products remain geographic. Without these, the bundled
# 2K LROC colour map and a flat displacement surface remain available.
PAS_DE_GEANT_LUNAR_IMAGERY_MAX_ZOOM=8
# Public browser URL for a static deployment; requires CORS and no credentials.
# Supplies streamed detail tiles. The product descriptor selects the base;
# format 2 uses a separate full-latitude equirectangular base.png.
PAS_DE_GEANT_LUNAR_IMAGERY_URL_TEMPLATE=
# Public product descriptor. Derived from a public /imagery/{z}/{x}/{y}.png
# template when omitted; otherwise defaults to the local product.json route.
PAS_DE_GEANT_LUNAR_IMAGERY_PRODUCT_URL=
# Development-only alternative to an upstream URL: an absolute or app-relative
# directory containing {z}/{x}/{y}.png (for example, a producer output's
# imagery directory). The same-origin /api/tiles route remains unchanged.
PAS_DE_GEANT_LUNAR_IMAGERY_DIRECTORY=

# Optional generated Apollo 11 preview root, including product.json and imagery/.
# Defaults to .cache/apollo11-preview in the repository root.
PAS_DE_GEANT_LUNAR_PREVIEW_DIRECTORY=
# Optional prepared 3D payload root, distinct from the geographic study preview.
# Defaults to PAS_DE_GEANT_LUNAR_PREVIEW_DIRECTORY/runtime.
PAS_DE_GEANT_LUNAR_RUNTIME_DIRECTORY=
# Geographic study base only; defaults to immutable 20261011.1 WAC, zooms 0–8.
PAS_DE_GEANT_LUNAR_STUDY_IMAGERY_URL_TEMPLATE=
# Development-only local elevation pyramid, containing {z}/{x}/{y}.png.
PAS_DE_GEANT_LUNAR_ELEVATION_DIRECTORY=
# Separate scientific height descriptor: elevation-xyz formatVersion 2.
PAS_DE_GEANT_LUNAR_ELEVATION_PRODUCT_URL=
PAS_DE_GEANT_LUNAR_ELEVATION_URL_TEMPLATE=
